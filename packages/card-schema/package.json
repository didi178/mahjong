{
  "name": "@mahjong/card-schema",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo",
    "validate": "node dist/cli-validate.js"
  },
  "dependencies": {
    "@mahjong/tile-model": "workspace:*",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
